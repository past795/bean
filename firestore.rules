rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function personId() {
      return request.auth.token.email in [
        'allison@taiwanbar.cc',
        'past795@gmail.com'
      ] ? 'person-jy' : request.auth.uid;
    }

    function isTripMember(tripId) {
      return signedIn() && exists(
        /databases/$(database)/documents/trips/$(tripId)/members/$(personId())
      );
    }

    function isTripOwner(tripId) {
      return isTripMember(tripId) && get(
        /databases/$(database)/documents/trips/$(tripId)/members/$(personId())
      ).data.role == 'owner';
    }

    function ownsTripDocument(tripId) {
      return signedIn() && exists(
        /databases/$(database)/documents/trips/$(tripId)
      ) && get(
        /databases/$(database)/documents/trips/$(tripId)
      ).data.ownerId == personId();
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && userId == personId();
      allow delete: if false;

      match /favorites/{favoriteId} {
        allow read, write: if signedIn() && userId == personId();
      }

      match /trips/{tripId} {
        allow read, create, update: if signedIn() && userId == personId();
        allow delete: if signedIn() && (userId == personId() || isTripOwner(tripId));
      }
    }

    // Invite codes are deliberately readable only by a signed-in user who
    // already knows the code.  Listing is not allowed, and only a trip owner
    // may point a code at their own trip.
    match /invites/{inviteCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() &&
        request.resource.data.tripId is string &&
        ownsTripDocument(request.resource.data.tripId);
      allow delete: if signedIn() &&
        resource.data.tripId is string &&
        ownsTripDocument(resource.data.tripId);
    }

    match /trips/{tripId} {
      allow create: if signedIn() && request.resource.data.ownerId == personId();
      // The owner fallback repairs older trips whose member record was not
      // created because the previous client wrote these documents out of order.
      allow read, update: if isTripMember(tripId) || ownsTripDocument(tripId);
      allow delete: if isTripOwner(tripId);

      match /members/{memberId} {
        allow read: if isTripMember(tripId) || ownsTripDocument(tripId);
        allow create: if signedIn() && memberId == personId() &&
          exists(/databases/$(database)/documents/trips/$(tripId)) && (
            get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId == personId() ||
            (
              get(/databases/$(database)/documents/trips/$(tripId)).data.inviteCode is string &&
              get(/databases/$(database)/documents/trips/$(tripId)).data.inviteCode.size() == 6 &&
              request.resource.data.inviteCode == get(/databases/$(database)/documents/trips/$(tripId)).data.inviteCode
            )
          );
        allow update: if signedIn() && (memberId == personId() || isTripOwner(tripId));
        allow delete: if signedIn() && memberId == personId() && resource.data.role != 'owner';
      }

      match /{collection}/{documentId} {
        allow read, write: if isTripMember(tripId) || ownsTripDocument(tripId);
      }
    }
  }
}
