rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function personId() {
      return request.auth.token.email in [
        'allison@taiwanbar.cc',
        'past795@gmail.com'
      ] ? 'person-jy' : request.auth.uid;
    }

    function isTripMember(tripId) {
      return signedIn() && exists(
        /databases/$(database)/documents/trips/$(tripId)/members/$(personId())
      );
    }

    function isTripOwner(tripId) {
      return isTripMember(tripId) && get(
        /databases/$(database)/documents/trips/$(tripId)/members/$(personId())
      ).data.role == 'owner';
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && userId == personId();
      allow delete: if false;

      match /favorites/{favoriteId} {
        allow read, write: if signedIn() && userId == personId();
      }

      match /trips/{tripId} {
        allow read, write: if signedIn() && userId == personId();
      }
    }

    match /trips/{tripId} {
      allow create: if signedIn() && request.resource.data.ownerId == personId();
      allow read, update: if isTripMember(tripId);
      allow delete: if isTripOwner(tripId);

      match /members/{memberId} {
        allow read: if isTripMember(tripId);
        allow create: if signedIn() && memberId == personId();
        allow update: if signedIn() && (memberId == personId() || isTripOwner(tripId));
        allow delete: if signedIn() && memberId == personId() && resource.data.role != 'owner';
      }

      match /{collection}/{documentId} {
        allow read, write: if isTripMember(tripId);
      }
    }
  }
}
